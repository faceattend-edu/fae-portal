# =========================================================================
# fae-portal — Plantilla de variables de entorno
# =========================================================================

# Puerto local donde se expone Nginx (docker-compose.yml sin TLS)
WEB_PORT=8080

# URL pública del API Gateway consumida por la SPA en el navegador
# - Local con Nginx reverse-proxy: /api/v1
# - Producción (Vercel apuntando al VPS): https://api.tu-dominio.com/api/v1
EXPO_PUBLIC_API_URL=/api/v1
EXPO_PUBLIC_SESSION_MODE=bearer
EXPO_PUBLIC_WS_URL=

# TLS con Caddy (docker-compose.tls.yml)
DOMAIN=
ACME_EMAIL=
